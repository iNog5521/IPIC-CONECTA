rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Usuários: qualquer usuário logado pode criar e ler, mas só pode editar o próprio ou se for administrador
    match /users/{userId} {
      allow read: if request.auth != null;
      
      // CRIAÇÃO: O próprio usuário cria seu perfil.
      // Regra: Deve ser o próprio UID e o cargo deve ser 'user' (ou 'owner' se for o seu e-mail)
      allow create: if request.auth != null && request.auth.uid == userId && (
        (request.resource.data.email.lower() == 'inog5521@gmail.com' && request.resource.data.role == 'owner') ||
        (request.resource.data.email.lower() != 'inog5521@gmail.com' && request.resource.data.role == 'user')
      );
      
      // ATUALIZAÇÃO: 
      // 1. O dono do perfil pode atualizar, MAS NÃO pode mudar o cargo (role), email ou uid.
      // 2. Administradores podem atualizar tudo.
      allow update: if request.auth != null && (
        (request.auth.uid == userId && 
         request.resource.data.role == resource.data.role && 
         request.resource.data.email == resource.data.email &&
         request.resource.data.uid == resource.data.uid) || 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['owner', 'admin']
      );
      
      allow delete: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['owner', 'admin'];
    }
    
    // Sedes: leitura pública
    match /sedes/{sedeId} {
      allow read: if true;
      allow write: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['owner', 'admin'];
    }
    
    // Cultos: leitura pública para todos
    match /cultos/{cultoId} {
      allow read: if true;
      allow write: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['owner', 'admin'];
    }
    
    // Avisos: leitura pública
    match /avisos/{avisoId} {
      allow read: if true;
      allow write: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['owner', 'admin'];
    }
    
    // Palavras: leitura pública
    match /palavra/{palavraId} {
      allow read: if true;
      allow write: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['owner', 'admin'];
    }
    
    // Confirmações: qualquer usuário logado pode ler e criar
    match /confirmacoes/{confirmId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow delete: if request.auth != null && 
        resource.data.userId == request.auth.uid;
    }
    
    // Membros: qualquer usuário logado pode ler
    match /membros/{membroId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['owner', 'admin'];
    }
    
    match /agenda/{eventId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['owner', 'admin'];
    }
    
    match /oracoes/{orcaoId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['owner', 'admin'];
    }
    
    match /mensagens_admin/{msgId} {
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid || 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['owner', 'admin']
      );
      allow create: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['owner', 'admin'];
      allow update: if request.auth != null && (
        resource.data.userId == request.auth.uid || 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['owner', 'admin']
      );
      allow delete: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['owner', 'admin'];
    }
  }
}