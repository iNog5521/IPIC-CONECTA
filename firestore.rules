rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Regra Global: Apenas Administradores e Owners podem ler/escrever em coleções protegidas
    function isAdmin() {
      return request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['owner', 'admin'];
    }

    // Modelos de Mural: Leitura pública e escrita protegida para Admins/Owners
    match /modelos_mural/{modeloId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Avisos: leitura pública
    match /avisos/{avisoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Usuários: qualquer usuário logado pode ler, mas só pode editar o próprio ou se for administrador
    match /users/{userId} {
      allow read: if request.auth != null;
      
      // CRIAÇÃO: O próprio usuário cria seu perfil.
      allow create: if request.auth != null && request.auth.uid == userId;
      
      // ATUALIZAÇÃO: O dono ou Admin/Owner
      allow update: if request.auth != null && (
        (request.auth.uid == userId && 
         request.resource.data.role == resource.data.role && 
         request.resource.data.email == resource.data.email &&
         request.resource.data.uid == resource.data.uid) || 
        isAdmin()
      );
      
      allow delete: if isAdmin();
    }
    
    // Sedes, Cultos, Palavra: leitura pública
    match /sedes/{sedeId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /cultos/{cultoId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /palavra/{palavraId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Confirmações: qualquer usuário logado pode ler e criar
    match /confirmacoes/{confirmId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow delete: if request.auth != null && 
        resource.data.userId == request.auth.uid;
    }
    
    // Membros, Agenda, Orações: qualquer usuário logado pode ler
    match /membros/{membroId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    
    match /agenda/{eventId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    
    match /oracoes/{orcaoId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    
    // Mensagens Admin: O dono ou Admin/Owner
    match /mensagens_admin/{msgId} {
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid || 
        isAdmin()
      );
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (
        resource.data.userId == request.auth.uid || 
        isAdmin()
      );
    }

    // Regra de segurança padrão para qualquer outra coleção não listada
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}