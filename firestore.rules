rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Usuários: cada usuário só pode ler/escrever seu próprio documento
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Todo o resto: qualquer usuário autenticado pode ler e escrever
    // Para produção, você pode restringir usando custom claims (Cloud Functions)
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}